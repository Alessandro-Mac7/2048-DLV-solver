% ============================================================
% SPAWN AVVERSARIALE (M3) — sovrapposizione a plan.dlv2
%
% Si concatena al programma base solo quando la modalita' e' attiva. Spenta non
% costa nulla: senza i fatti ramo/2 nessuna di queste regole ha corpo.
%
% Il piano resta la catena di H mosse del programma base. In fondo, dopo
% l'ultima mossa, l'avversario piazza una tessera nella casella peggiore: si
% aprono tutti i piazzamenti possibili come stati foglia e si valuta il PEGGIO
% fra loro, non la media. In ingresso, dal chiamante: ramo(K,N) per ogni indice
% di casella K, con N identificativo dello stato foglia, e i time(N) relativi.
%
% ---- perche' l'avversario e' ENUMERATO e non indovinato
% Il tentativo ovvio — spawn(R,C) | nospawn(R,C) — non funziona, e il motivo
% merita di essere scritto perche' non e' evidente. I weak constraint
% MINIMIZZANO su tutto l'answer set, mosse e spawn insieme: il solver
% sceglierebbe il piazzamento piu' comodo, cioe' un avversario COMPLICE, e il
% modello sarebbe ottimista — peggio che non averne. Per avere il peggiore
% serve un "per ogni spawn", e in ASP un quantificatore universale si ottiene
% solo per saturazione, tecnica che pretende un controllo MONOTONO nelle
% atomiche indovinate. La meccanica di 2048 non lo e' in nessuna direzione: una
% tessera in piu' riempie una casella (peggio) ma puo' anche creare una coppia
% fondibile (meglio). Le caselle pero' sono al massimo 16: aprirle tutte e
% prendere il massimo costa meno di qualunque saturazione, ed e' esatto.
%
% ---- perche' la reazione del giocatore non e' modellata ramo per ramo
% Una versione precedente costruiva un albero alternato completo, con una mossa
% indovinata per ogni ramo. Due misure l'hanno bocciata. Costo: 30 s per una
% mossa a due livelli di avversario, contro il budget di 3 s. Correttezza: in
% quell'albero step/1 diventava un predicato DERIVATO dentro una componente con
% negazione ricorsiva (step dipende da haMossa, che dipende da at, che dipende
% dalla mossa del padre), e il vincolo ":- step(T), not qualche(T)" smetteva di
% mordere — DLV2 restituiva l'answer set vuoto, cioe' "nessuna mossa", su board
% con quattro mosse legali (32 volte su 321, misurato). Qui step/1 resta un
% fatto del chiamante e il problema non esiste.
% ============================================================

cella(K,R,C) :- idx(R), idx(C), K=R*4+C.

% ---- le foglie: lo stato finale del piano piu' una tessera dell'avversario.
% La tessera e' sempre un 2. Il gioco vero mette un 4 una volta su dieci e un
% avversario davvero peggiore sceglierebbe anche il valore, ma raddoppiare i
% rami per il caso da 10% non paga: il danno di una tessera sta quasi tutto
% nella casella che occupa.
ramoValido(K,N) :- ramo(K,N), horizon(TH), cella(K,R,C), not occ(TH,R,C).
foglia(N)       :- ramoValido(_,N).

at(N,R,C,X) :- ramoValido(K,N), horizon(TH), at(TH,R,C,X).
at(N,R,C,1) :- ramoValido(K,N), cella(K,R,C).

% Esiste una mossa legale se c'e' una casella vuota o due tessere uguali
% adiacenti. E' un controllo positivo e locale: non serve far girare la
% meccanica nelle quattro direzioni per sapere se la posizione e' viva.
haMossa(N) :- foglia(N), at(N,R,C,E), C1=C+1, at(N,R,C1,E).
haMossa(N) :- foglia(N), at(N,R,C,E), R1=R+1, at(N,R1,C,E).
haMossa(N) :- foglia(N), idx(R), idx(C), not occ(N,R,C).
morto(N)   :- foglia(N), not haMossa(N).

% ============================================================
% IL PEGGIO SUI RAMI
% Due soli termini, sopra tutti quelli del programma base: sono le uniche due
% cose che cambiano da ramo a ramo. Il riempimento no — ogni foglia ha una
% tessera in piu' dello stato finale, sempre la stessa quantita' — e nemmeno
% l'angolo, perche' un 2 non sposta il massimo. Metterli sarebbe copiare
% criteri che la catena gia' pesa.
% ============================================================
domRami(0..16).

% Quante caselle chiudono la partita: e' il segnale che il modello lineare non
% ha a nessuna profondita'. Contarle, invece di guardare solo se ne esiste una,
% distingue "una casella letale su otto" da "tutte letali".
quantiMorti(N) :- domRami(N), #count{M : morto(M)} = N.

% Il disordine peggiore che l'avversario puo' produrre piazzando la tessera.
peggiorDisordine(D) :- dom24(D), #max{Dz : foglia(N), disordine(N,Dz)} = D.

:~ quantiMorti(N).      [N@6]
:~ peggiorDisordine(D). [D@5]
