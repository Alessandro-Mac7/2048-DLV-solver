% ============================================================
% 2048 come problema di PIANIFICAZIONE in ASP (DLV2 / ASP-Core-2)
% Valori = ESPONENTI: valore reale = 2^E
%
% In ingresso:  at(0,R,C,E).  horizon(H).  time(0..H).  step(0..H-1).
% In uscita:    move(T,D) con D in {u,d,l,r}
%
% NB: i ranghi usano conteggio RICORSIVO e non #count, perche' at(T+1)
% dipende da at(T) attraverso i ranghi e gli aggregati ricorsivi con la
% testa sono vietati. La formulazione e' gia' validata: non "semplificarla"
% rimettendo #count senza rimisurare.
%
% NB2: nessun peso di weak constraint deve poter diventare NEGATIVO. Un
% "C=K-N" va sempre accoppiato a un dominio di N che si ferma a K, altrimenti
% DLV2 riporta un costo che non e' quello scritto e l'ottimo che restituisce
% non e' quello che si crede di aver chiesto.
% ============================================================

idx(0..3).
dir(u). dir(d). dir(l). dir(r).

% ---- proiezione cella -> (linea, posizione); P=0 = estremo di arrivo
lin(l,R,C,R,C) :- idx(R), idx(C).
lin(r,R,C,R,P) :- idx(R), idx(C), P=3-C.
lin(u,R,C,C,R) :- idx(R), idx(C).
lin(d,R,C,C,P) :- idx(R), idx(C), P=3-R.

% ---- GUESS: esattamente una mossa per passo
move(T,D) | nomove(T,D) :- step(T), dir(D).
qualche(T) :- move(T,_).
:- step(T), not qualche(T).
:- move(T,D), move(T,D2), D < D2.

% ---- proiezione dello stato sulla linea (solo direzione scelta)
lat(T,D,L,P,E) :- at(T,R,C,E), lin(D,R,C,L,P), move(T,D).
locc(T,D,L,P)  :- lat(T,D,L,P,_).
lline(T,D,L)   :- move(T,D), idx(L).

% ---- rango fra le occupate: conteggio progressivo (no aggregati)
cnt(T,D,L,0,0)   :- lline(T,D,L).
cnt(T,D,L,P1,N1) :- cnt(T,D,L,P,N), locc(T,D,L,P), P1=P+1, P1<=3, N1=N+1.
cnt(T,D,L,P1,N)  :- cnt(T,D,L,P,N), not locc(T,D,L,P), P1=P+1, P1<=3.
lrank(T,D,L,P,N) :- locc(T,D,L,P), cnt(T,D,L,P,N).
comp(T,D,L,K,E)  :- lat(T,D,L,P,E), lrank(T,D,L,P,K).

% ---- merge greedy lungo la linea (stratificato localmente su K)
mrg(T,D,L,K)   :- comp(T,D,L,K,E), K1=K+1, comp(T,D,L,K1,E), not cons(T,D,L,K).
cons(T,D,L,K1) :- mrg(T,D,L,K), K1=K+1.

% ---- sopravvissute dopo il merge
surv(T,D,L,K,E1) :- mrg(T,D,L,K), comp(T,D,L,K,E), E1=E+1.
surv(T,D,L,K,E)  :- comp(T,D,L,K,E), not cons(T,D,L,K), not mrg(T,D,L,K).
soc(T,D,L,K)     :- surv(T,D,L,K,_).

% ---- rango dopo il merge
scnt(T,D,L,0,0)   :- lline(T,D,L).
scnt(T,D,L,K1,N1) :- scnt(T,D,L,K,N), soc(T,D,L,K), K1=K+1, K1<=3, N1=N+1.
scnt(T,D,L,K1,N)  :- scnt(T,D,L,K,N), not soc(T,D,L,K), K1=K+1, K1<=3.
srank(T,D,L,K,N)  :- soc(T,D,L,K), scnt(T,D,L,K,N).

% ---- stato successivo
% Due indirezioni, entrambe al servizio della sovrapposizione avversariale:
%
% esito -> at, perche' l'avversario deve poter infilare una tessera FRA la
% mossa e lo stato successivo. Senza di essa "cella libera dopo la mossa" si
% leggerebbe da at, che a sua volta conterrebbe la tessera infilata, e il
% ciclo negativo lascerebbe ogni spawn privo di supporto: nessuna tessera
% verrebbe mai piazzata.
%
% succ al posto di T1=T+1 per tenere separato "il passo dopo" dal nome del
% nodo: il tempo non e' piu' solo la catena, perche' la sovrapposizione
% avversariale aggiunge stati che non stanno su di essa.
succ(T,T1) :- step(T), T1=T+1, time(T1).
esito(T1,R,C,E) :- surv(T,D,L,K,E), srank(T,D,L,K,J), lin(D,R,C,L,J),
                   move(T,D), succ(T,T1).
at(T,R,C,E) :- esito(T,R,C,E).

% ---- legalita': deve esserci un merge o uno scorrimento
legale(T,D) :- comp(T,D,L,K,E), K1=K+1, comp(T,D,L,K1,E).
legale(T,D) :- locc(T,D,L,P), lrank(T,D,L,P,K), K < P.
:- move(T,D), not legale(T,D).

% ============================================================
% VALUTAZIONE DELLO STATO A OGNI PASSO
% domini limitati: obbligatori perche' questi aggregati dipendono
% dal guess disgiuntivo
% ============================================================
dom16(0..16).
dom24(0..24).
domE(1..17).

% I passi del piano: gli stati che stanno sulla catena. La sovrapposizione
% avversariale aggiunge altri time(N) fuori dalla catena, e i costi sommati
% lungo il piano non devono contarli.
passo(T) :- time(T), horizon(TH), T>0, T<=TH.

occ(T,R,C) :- at(T,R,C,_).
piene(T,M) :- time(T), dom16(M), #count{R,C : occ(T,R,C)} = M.

% ---- CARICO: occupazione reale piu' le tessere che il gioco aggiungera'
% Questo termine e' il cuore della milestone. Senza spawn l'occupazione lungo
% il piano e' monotona NON CRESCENTE: le mosse possono solo far calare il
% numero di tessere. Ne segue che valutare ogni passo, da solo, non produce
% alcun segnale di rischio, e che un vincolo su piene(T) sarebbe o sempre
% soddisfatto o gia' violato a T=0. Il gioco vero pero' aggiunge UNA tessera
% per mossa: dopo T mosse ce ne sono T in piu' di quante il piano ne mostri.
% E' contando quelle che la board si riempie anche nel modello.
%
% Poiche' piene(T) = piene(0) - merge fatti finora, il carico dice anche una
% cosa che nessun altro termine diceva: per non affogare bisogna fondere
% almeno tanto quanto lo spawn riempie.
fantasmi(T,T) :- passo(T).
carico(T,M)  :- piene(T,P), fantasmi(T,F), M=P+F, dom16(M).
carico(T,16) :- piene(T,P), fantasmi(T,F), P+F > 16.

% ---- penalita' di riempimento PROGRESSIVA: M^2.
% Con un costo lineare un piano che passa per una posizione stretta costa
% quanto uno che tiene la board arieggiata; con uno convesso il passaggio da
% 13 a 14 occupate costa quanto quello da 0 a 7 messi insieme.
%
% Il quadrato parte da zero e non da una soglia. Una prima versione troncava a
% zero sotto le 5 caselle occupate, e su board larga il livello 3 diventava
% piatto: sparita la pressione a fondere, il solver si limitava a tenere le
% righe in ordine e il punteggio medio dimezzava (2780 contro 5207 del
% riferimento, 8 partite appaiate a H=2). Una penalita' di riempimento deve
% crescere ovunque, non solo dove fa paura.
costoCarico(0,0).    costoCarico(1,1).    costoCarico(2,4).   costoCarico(3,9).
costoCarico(4,16).   costoCarico(5,25).   costoCarico(6,36).  costoCarico(7,49).
costoCarico(8,64).   costoCarico(9,81).   costoCarico(10,100). costoCarico(11,121).
costoCarico(12,144). costoCarico(13,169). costoCarico(14,196).
costoCarico(15,225). costoCarico(16,256).

% ---- vincolo rigido: mai scendere sotto K caselle libere lungo il piano.
% Vale sul carico, non su piene, per il motivo detto sopra. Si attiva solo se
% la board di partenza ha gia' quel margine: imporlo su una board gia' stretta
% renderebbe il programma incoerente proprio quando serve una mossa, e il
% solver rifiuterebbe di muovere invece di giocare la meno peggio.
minLibere(2).
margineIniziale :- minLibere(K), piene(0,P), 16-P > K.
:- margineIniziale, minLibere(K), passo(T), carico(T,M), M > 16-K.

maxstato(T,E) :- time(T), domE(E), #max{E1 : at(T,_,_,E1)} = E.

% ---- ANCORAGGIO GRADUATO: distanza di Manhattan del massimo dall'angolo.
% Il criterio binario "il massimo e' in (0,0)" valutato solo a fine piano non
% costava nulla ai piani che scacciano il massimo dall'angolo a meta' strada
% per poi rimettercelo, e messo a ogni passo al livello piu' alto schiacciava
% tutto il resto (misurato: a H=3 la media crollava da ~5300 a ~3200).
% Graduato, e dentro la somma posizionale invece che sopra di essa, non ha
% nessuno dei due difetti.
%
% Il minimo perche' due caselle possono contenere lo stesso esponente massimo:
% conta la piu' vicina all'angolo, non tutte.
dom6(0..6).
posMax(T,D)  :- maxstato(T,E), at(T,R,C,E), D=R+C.
distMax(T,D) :- time(T), dom6(D), #min{D1 : posMax(T,D1)} = D.

% monotonia: coppie adiacenti in cui il valore CRESCE allontanandosi
% dall'angolo di ancoraggio (0,0), cioe' le rotture della "scala".
%
% Orizzontali E VERTICALI. Contare solo le righe non era una semplificazione
% ma una lacuna: nessuna regola guardava le colonne, quindi il modello poteva
% impilare righe ordinatissime in ordine fra loro casuale e non pagare nulla.
salita(T,R,C,R,C1) :- at(T,R,C,E), C1=C+1, at(T,R,C1,E1), E1>E.
salita(T,R,C,R1,C) :- at(T,R,C,E), R1=R+1, at(T,R1,C,E1), E1>E.

disordine(T,N) :- time(T), dom24(N),
                  #count{R,C,R2,C2 : salita(T,R,C,R2,C2)} = N.

% ---- LEVIGATEZZA: somma di |E-E1| sulle coppie adiacenti.
% Due tessere adiacenti molto diverse non potranno mai fondersi e si bloccano
% a vicenda lo spazio. La monotonia da sola non lo vede: un 2 accanto a un
% 1024 e un 512 accanto a un 1024 sono entrambi "in discesa", e valgono
% uguale.
%
% La somma NON passa da un aggregato con variabile di dominio: i weak
% constraint sommano gia' sui termini discriminanti distinti, e un dominio
% 0..384 replicato per ogni passo costerebbe grounding per nulla.
salto(T,R,C,R,C1,X) :- at(T,R,C,E), C1=C+1, at(T,R,C1,E1), E>=E1, X=E-E1.
salto(T,R,C,R,C1,X) :- at(T,R,C,E), C1=C+1, at(T,R,C1,E1), E1>E,  X=E1-E.
salto(T,R,C,R1,C,X) :- at(T,R,C,E), R1=R+1, at(T,R1,C,E1), E>=E1, X=E-E1.
salto(T,R,C,R1,C,X) :- at(T,R,C,E), R1=R+1, at(T,R1,C,E1), E1>E,  X=E1-E.

% ---- MERGE PESATI PER VALORE (proxy economico del punteggio)
% Contarli e basta equipara la fusione di due 2 a quella di due 512. Il premio
% e' l'ESPONENTE fuso, cioe' il logaritmo del valore e non il valore: i pesi
% grandi nei weak constraint fanno esplodere i tempi, e una scala logaritmica
% ordina i merge esattamente allo stesso modo restando a due cifre.
%
% Il costo e' il complemento del premio perche' nessun peso puo' essere
% negativo. Il tetto e' 255 e non e' scelto a occhio: nel modello non
% compaiono tessere nuove, quindi ogni merge toglie una tessera e da 16 se ne
% possono fare al piu' 15, ciascuna con esponente al piu' 17 (domE). Sopra il
% tetto premioMerge non verrebbe derivato e il livello diventerebbe muto.
domPremio(0..255).
premioMerge(S) :- domPremio(S),
                  #sum{E,T,D,L,K : mrg(T,D,L,K), comp(T,D,L,K,E)} = S.

% ============================================================
% OTTIMIZZAZIONE (livello piu' alto = piu' importante)
% T=0 e' escluso: e' la board data, identica per ogni piano candidato, quindi
% aggiungerebbe solo una costante. Il termine discriminante T serve a far
% SOMMARE i passi invece di collassarli in uno.
%
% Questi costi si sommano lungo la CATENA (passo/1). Gli stati che la
% sovrapposizione avversariale appende in fondo non ne fanno parte: li' il
% costo giusto e' il peggio sui rami, e lo aggiunge adversary.dlv2 ai livelli
% sopra questi.
%
% ---- PERCHE' TRE LIVELLI E NON QUATTRO
% I livelli lessicografici sono uno strumento brutale: il livello sotto conta
% solo a parita' esatta di quello sopra. Con quattro livelli un guadagno di un
% punto di riempimento batteva qualunque miglioramento di monotonia, e la
% monotonia batteva qualunque numero di merge.
%
% Riempimento e merge restano su livelli propri, perche' dicono cose di
% natura diversa: riempirsi e' fatale e il costo e' gia' convesso, i merge
% sono il guadagno e devono decidere solo a parita' di posizione.
%
% I termini POSIZIONALI invece descrivono tutti la stessa cosa da angoli
% diversi — quanto la board e' pettinata verso l'angolo — e ordinarli fra loro
% e' arbitrario. Stanno in un solo livello con pesi relativi, come fanno gli
% AI forti di 2048, che valutano una somma pesata e non una gerarchia.
%
% I pesi: la monotonia conta 4 per coppia invertita, la levigatezza 1 per
% unita' di esponente (una coppia 2/1024 vale gia' 9), la distanza del massimo
% dall'angolo 3 per casella. Ordini di grandezza confrontabili per passo, che
% e' l'unica cosa che serve: nessuno dei tre deve poter azzerare gli altri.
%
% Il tag costante (mon/lev/anc) nei termini discriminanti serve a impedire che
% due weak constraint dello stesso livello collassino sulla stessa tupla.
% ============================================================
:~ passo(T), carico(T,M), costoCarico(M,W).   [W@3, T]

:~ passo(T), disordine(T,N), W=N*4.           [W@2, mon,T]
:~ passo(T), salto(T,R,C,R2,C2,X).            [X@2, lev,T,R,C,R2,C2]
:~ passo(T), distMax(T,D), W=D*3.             [W@2, anc,T]

:~ premioMerge(S), C=255-S.                   [C@1]
